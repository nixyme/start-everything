{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "START EVERYTHING",
  "version": "2.3.0",
  "identifier": "com.nixyme.start-everything-new",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "START EVERYTHING",
      "width": 1180,
      "height": 800,
      "minWidth": 760,
      "minHeight": 540,
      "center": true,
      "backgroundColor": "#121212",
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [{
        "identifier": "main",
        "windows": ["main"],
        "permissions": ["core:default", "core:event:default", "core:webview:allow-internal-toggle-devtools", "core:window:allow-set-focus", "core:window:allow-set-title", "notification:default"]
      }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Universal project and command launcher",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "linux": { "deb": { "depends": [] } }
  }
}
